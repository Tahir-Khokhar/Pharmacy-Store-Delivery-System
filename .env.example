# PharmaCare Environment Configuration Template
DJANGO_SECRET_KEY=django-insecure-replace-with-a-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (Optional PostgreSQL)
DB_NAME=pharmacare_db
DB_USER=pharma_user
DB_PASSWORD=pharma_secure_password
DB_HOST=localhost
DB_PORT=5432

# Redis Cache
REDIS_URL=redis://127.0.0.1:6379/1

# Security & Limits
MAX_UPLOAD_SIZE=5242880
ALLOWED_PRESCRIPTION_EXTENSIONS=.pdf,.jpg,.jpeg,.png
